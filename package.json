{
  "name": "formatx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FormatX – Universal Data Formatter & Validator. Client-side detection, validation, formatting and conversion for structured data and code.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit",
